# Development and CI dependencies: the INPUT. The tool itself needs only the Python standard library; everything here
# exists to test and check the repository. CI installs requirements-dev.txt, which is this file resolved to exact
# versions with hashes, the same for every Python from 3.10. `mcp` is pinned to the image's, so the suite runs against
# the MCP SDK that ships; numpy resolves per Python, since the image's 2.4 needs 3.11 and the suite runs on 3.10 too.
# To change a floor, edit this file and run:
#
#   uv pip compile requirements-dev.in --universal --generate-hashes --python-version 3.10 -o requirements-dev.txt
#
pytest>=8.0
pytest-cov>=5.0
coverage>=7.4
# Lint. The ruleset catches defects rather than restyling code (see ruff.toml), so a newer ruff
# is unlikely to start failing the build on style.
ruff>=0.6
# Shell lint for hooks/*.sh and tools/*.sh. The wheel bundles the shellcheck binary.
shellcheck-py>=0.10
# Optional at runtime, required by the MCP server test.
mcp==2.2.0                 # the image's pin: requirements-runtime.in
# Optional at runtime (the image pins it); here so the suite tests vector_rank's numpy path.
numpy>=2.0
# The workflow linter CI runs, for tools/run_ci_locally.sh.
actionlint-py>=1.7
