#!/usr/bin/env python3
"""Stand-in for `claude -p`, for tools/e2e.sh. Refuses to run without the recursion guard, logs each
answered prompt to E2E_CLI_LOG, and answers with one traceable lesson, as JSON when asked for it.

E2E_FAIL_AFTER=N answers N calls in all (counted from the log) and then reports a usage limit; so
does E2E_FAIL_ON=text for any prompt containing text. The report is the CLI's own shape: exit status
0, `is_error` in the JSON."""
import json
import os
import re
import sys
from pathlib import Path


def main():
    """Answer one `claude -p` call the way the e2e suite expects, or report a usage limit when told to."""
    if os.environ.get("MEMORY_REFLECT") != "1":
        sys.exit(3)
    prompt = sys.stdin.read()
    log = Path(os.environ["E2E_CLI_LOG"])
    answered = len(log.read_text(encoding="utf-8").splitlines()) if log.exists() else 0
    fmt = sys.argv[sys.argv.index("--output-format") + 1] if "--output-format" in sys.argv else "text"
    limit = os.environ.get("E2E_FAIL_AFTER")
    if (limit and answered >= int(limit)) or (os.environ.get("E2E_FAIL_ON") and os.environ["E2E_FAIL_ON"] in prompt):
        print(json.dumps({"type": "result", "subtype": "success", "is_error": True, "result": "Claude AI usage limit reached"}))
        sys.exit(0)
    with log.open("a", encoding="utf-8") as f:
        f.write(json.dumps({"argv": sys.argv[1:], "prompt": prompt}) + "\n")
    if "CANDIDATES:" in prompt:
        text = '{"same": [], "contradicts": []}'
    else:
        m = re.search(r"Default project for this conversation: (\S+)", prompt)
        proj = m.group(1) if m else "all"
        text = json.dumps([{"project": proj, "text": f"cli lesson for {proj}"}])
    print(json.dumps({"type": "result", "subtype": "success", "is_error": False, "result": text}) if fmt == "json" else text)


main()
