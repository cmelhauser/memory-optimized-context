#!/usr/bin/env python3
"""
memory — personal memory system for Claude. One file, stdlib only, Python 3.10+.
Optional extras: `anthropic` (SDK) or `claude` CLI for reflection; `mcp` for the MCP server.

Layout ($MEMORY_ROOT, default ~/memory):
  memory.db            SQLite: lessons + FTS5 (+ optional embeddings)   ← only `memory` writes this
  journal/DATE/*.md    raw LESSONS files, one per hook event / claude.ai note (never edited)
  compiled/            PLAYBOOK.md + projects/*.md, atomic rename       ← only `memory` writes this
  archive/             pruned + superseded lessons, dated markdown
  .lock/               mkdir lock; every write path takes it

Subcommands:
  hook      called by Claude Code hooks (stdin/--input JSON): journal LESSONS, reflect transcript tail, ingest, compile
  ingest    journal files, --transcript PATH, --export conversations.json; --wait S caps the wait for the lock
  learn     everything else, incrementally: --repo (commit messages + docs), --notes, --transcripts
            (backfill ~/.claude/projects), --export; --all does all of them
  compile   write compiled/*.md from active lessons (also prunes)
  search    hybrid FTS5 + vector, RRF
  remember  add one lesson by hand
  vote      --helpful/--harmful ID
  mcp       MCP server exposing recall / remember / feedback. --transport stdio (Claude Desktop, docker exec -i)
            or --transport http (Claude Code: claude mcp add --transport http memory http://127.0.0.1:8765/mcp)
"""
import argparse, hashlib, json, math, os, re, shutil, sqlite3, subprocess, sys, tempfile, threading, time, urllib.request
from array import array
from contextlib import contextmanager, suppress
from datetime import datetime, timezone
from pathlib import Path

# ---------------------------------------------------------------- config
ROOT = Path(os.environ.get("MEMORY_ROOT", Path.home() / "memory"))
JOURNAL, COMPILED, ARCHIVE, LOCK = (ROOT / p for p in ("journal", "compiled", "archive", ".lock"))
DB = Path(os.environ.get("MEMORY_DB", ROOT / "memory.db"))   # in Docker: a named volume, not a macOS bind mount
CFG = {
    "llm": os.environ.get("MEMORY_LLM", "auto"),          # auto | sdk | cli | none
    "model": os.environ.get("MEMORY_MODEL", "claude-haiku-4-5-20251001"),
    "embed": os.environ.get("MEMORY_EMBED", "none"),      # none | voyage | openai
    "embed_model": os.environ.get("MEMORY_EMBED_MODEL", ""),
    "half_life_days": float(os.environ.get("MEMORY_HALF_LIFE", "90")),
    "max_lines": int(os.environ.get("MEMORY_MAX_LINES", "150")),
    "min_score": float(os.environ.get("MEMORY_MIN_SCORE", "0.15")),
    "transcript_chars": 30000,
}
def NOW():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")
LESSON_RE = re.compile(r"^\[([a-z0-9][a-z0-9._-]*)\]\s+(.+?)\s*$", re.I)
PROJECT_RE = re.compile(r"[a-z0-9][a-z0-9._-]*")   # a slug is a name: `compile_` makes it a filename, so never a path

def as_project(value, default):
    """A slug the store and the filesystem both accept, or `default`. The Reflector chooses the slug from text that
    reached a session, so `../` and friends must not survive the trip to `compiled/projects/<slug>.md`."""
    v = str(value).strip().lower()
    return v if PROJECT_RE.fullmatch(v) else default


def log(*a):
    print("[memory]", *a, file=sys.stderr)


# ---------------------------------------------------------------- lock (single writer)
LOCK_WAIT = 20   # seconds a writer waits for the lock; the SessionStart hook passes `ingest --wait 2`
LOCK_BEAT = 60   # a holder touches the lock this often, so only a crashed holder's lock goes 600 s untouched

class LockBusy(SystemExit):
    """Another writer held the lock for the whole wait, usually a long `learn`. A SystemExit, so the CLI still exits
    with the message; the MCP tools catch it and answer "busy" rather than stop the server."""

class Lock:
    def __init__(self, wait=None):
        self.wait = LOCK_WAIT if wait is None else wait
        self.done = threading.Event()
    def __enter__(self):
        ROOT.mkdir(parents=True, exist_ok=True)
        for _ in range(int(self.wait * 10)):
            try:
                LOCK.mkdir()
            except FileExistsError:
                if time.time() - LOCK.stat().st_mtime > 600:   # untouched for 600 s: its holder crashed
                    LOCK.rmdir(); continue
                time.sleep(0.1)
            else:
                threading.Thread(target=self.beat, daemon=True).start(); return self
        raise LockBusy(f"memory: the lock was held for all of {self.wait:g} s (a long `learn`?); try again when it ends")
    def beat(self):
        """Keep the lock fresh for as long as it is held; a `learn` can hold it for hours."""
        while not self.done.wait(LOCK_BEAT):
            with suppress(FileNotFoundError): os.utime(LOCK)
    def __exit__(self, *e):
        self.done.set()
        with suppress(FileNotFoundError): LOCK.rmdir()


# ---------------------------------------------------------------- store
SCHEMA = """
CREATE TABLE IF NOT EXISTS lessons(
  id TEXT PRIMARY KEY, project TEXT NOT NULL, text TEXT NOT NULL,
  votes INTEGER DEFAULT 1, helpful INTEGER DEFAULT 0, harmful INTEGER DEFAULT 0,
  first_seen TEXT, last_seen TEXT, superseded_by TEXT, state TEXT DEFAULT 'active', embedding BLOB);
CREATE VIRTUAL TABLE IF NOT EXISTS fts USING fts5(id UNINDEXED, project UNINDEXED, text);
CREATE TABLE IF NOT EXISTS sources(key TEXT PRIMARY KEY, cursor TEXT, seen TEXT);
"""

def db():
    ROOT.mkdir(parents=True, exist_ok=True); DB.parent.mkdir(parents=True, exist_ok=True)
    c = sqlite3.connect(DB, timeout=30)
    c.execute("PRAGMA journal_mode=WAL"); c.executescript(SCHEMA); c.row_factory = sqlite3.Row
    return c

def norm(t):
    return re.sub(r"\s+", " ", t.strip().lower().rstrip("."))

def lid(project, text):
    return hashlib.sha1(f"{project}|{norm(text)}".encode()).hexdigest()[:10]

def upsert(c, project, text):
    """ADD-only. Exact duplicate → +1 vote. Returns (id, is_new)."""
    project = project.lower(); text = text.strip()
    i = lid(project, text); now = NOW()
    row = c.execute("SELECT id FROM lessons WHERE id=?", (i,)).fetchone()
    if row:
        c.execute("UPDATE lessons SET votes=votes+1, last_seen=?, state=CASE WHEN state='archived' THEN 'active' ELSE state END WHERE id=?", (now, i))
        return i, False
    c.execute("INSERT INTO lessons(id,project,text,first_seen,last_seen) VALUES(?,?,?,?,?)", (i, project, text, now, now))
    c.execute("INSERT INTO fts(id,project,text) VALUES(?,?,?)", (i, project, text))
    return i, True

def score(r, now_ts=None):
    now_ts = now_ts or time.time()
    last = datetime.fromisoformat(r["last_seen"]).timestamp()
    age = max(0.0, (now_ts - last) / 86400)
    base = r["votes"] + r["helpful"] - 2 * r["harmful"]
    return base * (0.5 ** (age / CFG["half_life_days"]))


# ---------------------------------------------------------------- Claude adapter
REFLECTOR = {"why": ""}   # why the last call gave no answer, so a stop can say it instead of "the log says why"

def no_answer(why):
    """Log why a call gave nothing and keep the reason. An unattended run's last line is often all the operator
    ever sees, so it has to name the cause: an expired login reads nothing like a spent budget."""
    log(why); REFLECTOR["why"] = why
    return None

def cli_reason(r):
    """The reason a `claude -p` call failed. The CLI reports it in `result`, at the end of a JSON object whose head
    is counters, so reading the first bytes of stdout tells the operator nothing."""
    try: res = json.loads(r.stdout)
    except json.JSONDecodeError: res = None
    if isinstance(res, dict) and (res.get("result") or res.get("errors")):
        return str(res.get("result") or res.get("errors"))[:300]
    return (r.stderr or r.stdout or "no output").strip()[:300]

def llm(prompt, system="You are a precise assistant. Output only what is asked.", max_tokens=1500):
    """Returns text, or None when no answer came. Order: SDK (ANTHROPIC_API_KEY) → `claude -p` CLI (uses your
    subscription). A failure is logged and returned as None, never raised; reflect() turns it into ReflectorFailed."""
    mode = CFG["llm"]
    if mode == "none": return None
    if mode in ("auto", "sdk") and os.environ.get("ANTHROPIC_API_KEY"):
        try:
            import anthropic
            r = anthropic.Anthropic().messages.create(model=CFG["model"], max_tokens=max_tokens, system=system,
                                                      messages=[{"role": "user", "content": prompt}])
            return "".join(b.text for b in r.content if getattr(b, "type", "") == "text")
        except ImportError:
            if mode == "sdk": raise SystemExit("pip install anthropic") from None
        except Exception as e:                      # API, rate-limit or network error; auto mode tries the CLI next
            no_answer(f"the SDK call failed: {str(e)[:300]}")
            if mode == "sdk": return None
    if mode in ("auto", "cli") and shutil.which("claude"):
        env = {**os.environ, "MEMORY_REFLECT": "1", "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1"}  # hooks check MEMORY_REFLECT and exit
        try:
            with tempfile.TemporaryDirectory() as d:  # empty cwd → no CLAUDE.md, no project memory loaded
                r = subprocess.run(["claude", "-p", "--model", CFG["model"], "--output-format", "json", "--no-session-persistence"],
                                   input=f"{system}\n\n{prompt}", capture_output=True, text=True, env=env, cwd=d, timeout=180, check=False)
        except subprocess.TimeoutExpired:
            return no_answer("claude -p timed out")
        if r.returncode != 0:
            return no_answer(f"claude -p failed: {cli_reason(r)}")
        try: res = json.loads(r.stdout)
        except json.JSONDecodeError: return r.stdout           # plain text: an older CLI, or a stand-in
        if not isinstance(res, dict): return r.stdout
        if res.get("is_error") or res.get("subtype", "success") != "success":   # the CLI's own verdict, not only its exit status
            return no_answer(f"claude -p reported an error: {cli_reason(r)}")
        return res.get("result") or ""
    return no_answer("no Reflector: needs ANTHROPIC_API_KEY with `anthropic` installed, or `claude` on PATH")

def parse_json(text):
    """The first JSON array or object in the text that parses. An answer that opens with a sentence of its own, brackets
    and all, still yields its array: first-`[`-to-last-`]` would slice from the prose and parse as nothing."""
    if not text: return None
    dec = json.JSONDecoder()
    for m in re.finditer(r"[\[{]", text):
        try: return dec.raw_decode(text, m.start())[0]
        except json.JSONDecodeError: continue
    return None


# ---------------------------------------------------------------- embeddings (optional)
def embed(texts):
    """Vectors for texts, or None for each when embeddings are off, unkeyed, or the call fails; embed_missing retries."""
    if CFG["embed"] == "none" or not texts: return [None] * len(texts)
    if CFG["embed"] == "voyage":
        url, key, model = "https://api.voyageai.com/v1/embeddings", os.environ.get("VOYAGE_API_KEY"), CFG["embed_model"] or "voyage-3.5"
    else:
        url, key, model = "https://api.openai.com/v1/embeddings", os.environ.get("OPENAI_API_KEY"), CFG["embed_model"] or "text-embedding-3-small"
    if not key: log("no embedding API key; skipping"); return [None] * len(texts)
    out = []
    try:
        for i in range(0, len(texts), 64):
            req = urllib.request.Request(url, data=json.dumps({"input": texts[i:i+64], "model": model}).encode(),
                                         headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"})
            with urllib.request.urlopen(req, timeout=60) as r:
                out += [array("f", d["embedding"]).tobytes() for d in json.load(r)["data"]]
    except (OSError, ValueError, KeyError, TypeError) as e:   # network, HTTP or an odd body: embed later, never fail the run
        log("embedding call failed:", str(e)[:300]); return [None] * len(texts)
    if len(out) != len(texts):
        log(f"embedding call returned {len(out)} vectors for {len(texts)} texts"); return [None] * len(texts)
    return out

_dot = getattr(math, "sumprod", None) or (lambda x, y: sum(map(float.__mul__, x, y)))   # sumprod is 3.12+, ~10x faster

def cosine(a, b):
    x, y = array("f"), array("f"); x.frombytes(a); y.frombytes(b)
    if not x or not y or len(x) != len(y): return 0.0
    na, nb = math.sqrt(_dot(x, x)), math.sqrt(_dot(y, y))
    return _dot(x, y) / (na * nb) if na and nb else 0.0

def vector_rank(qe, rows, top=30):
    """Rows sorted by cosine to qe. numpy if present (one matmul), else the stdlib path."""
    try:
        import numpy as np
        M = np.frombuffer(b"".join(r["embedding"] for r in rows), dtype=np.float32).reshape(len(rows), -1)
        q = np.frombuffer(qe, dtype=np.float32)
        sims = (M @ q) / (np.linalg.norm(M, axis=1) * np.linalg.norm(q) + 1e-9)
        return [rows[i] for i in np.argsort(-sims)[:top]]
    except (ImportError, ValueError):
        return sorted(rows, key=lambda r: -cosine(qe, r["embedding"]))[:top]

def embed_missing(c):
    rows = c.execute("SELECT id,text FROM lessons WHERE embedding IS NULL AND state='active'").fetchall()
    if not rows or CFG["embed"] == "none": return
    for r, e in zip(rows, embed([r["text"] for r in rows]), strict=True):
        if e: c.execute("UPDATE lessons SET embedding=? WHERE id=?", (e, r["id"]))


# ---------------------------------------------------------------- search (hybrid, RRF)
def fts_query(q):
    toks = re.findall(r"[A-Za-z0-9_.\-]+", q)
    return " OR ".join(f'"{t}"' for t in toks) if toks else '""'

def search(c, q, project=None, k=8, include_archived=False):
    where = " AND l.state!='merged'" if include_archived else " AND l.state='active'"
    pw, pa = ("", ()) if not project else (" AND l.project IN (?, 'all')", (project.lower(),))
    ranks = {}
    rows = c.execute(f"SELECT l.* FROM fts JOIN lessons l ON l.id=fts.id WHERE fts MATCH ?{where}{pw} ORDER BY bm25(fts) LIMIT 30",
                     (fts_query(q), *pa)).fetchall()
    for i, r in enumerate(rows): ranks[r["id"]] = ranks.get(r["id"], 0) + 1 / (60 + i)
    if CFG["embed"] != "none":
        qe = embed([q])[0]
        if qe:
            cand = c.execute(f"SELECT * FROM lessons l WHERE embedding IS NOT NULL{where}{pw}", pa).fetchall()
            for i, r in enumerate(vector_rank(qe, cand)):
                ranks[r["id"]] = ranks.get(r["id"], 0) + 1 / (60 + i)
    if not ranks: return []
    ids = sorted(ranks, key=ranks.get, reverse=True)[:k]
    rows = {r["id"]: r for r in c.execute(f"SELECT * FROM lessons WHERE id IN ({','.join('?'*len(ids))})", ids)}
    return [rows[i] for i in ids if i in rows]


# ---------------------------------------------------------------- reflect (transcript → lessons)
REFLECT_SYS = ("You extract durable, reusable lessons from a conversation between a user and an AI assistant. "
               "A lesson is a fact, preference, correction, constraint, or decision that would change how the assistant acts in a FUTURE session. "
               "Skip task progress, pleasantries, and anything only true today. Prefer exact tokens (flags, filenames, versions). "
               "Never include secrets, credentials, health, or financial details. Output ONLY a JSON array of "
               '{"project": "<slug>", "text": "<one sentence>"}; use "all" for cross-project lessons. Empty array if nothing durable.')

class ReflectorFailed(Exception):
    """The Reflector was asked and gave no answer: an API or CLI error, a timeout, a usage limit, or no LLM at all.
    Callers leave their cursor where it was, so the same text is offered again next run. `new` carries the upserts
    the interrupted source had already made, so they are still reconciled and compiled."""
    def __init__(self, why, new=()):
        super().__init__(why); self.new = list(new)

@contextmanager
def carrying(new):
    """Add this source's upserts so far to a ReflectorFailed passing through."""
    try: yield
    except ReflectorFailed as e:
        e.new[:0] = new; raise

@contextmanager
def stopping(new):
    """For a command: stop at the first ReflectorFailed and add the upserts it carries to `new`. Yields a list that
    holds the failure, if there was one."""
    failed = []
    try: yield failed
    except ReflectorFailed as e:
        new += e.new; failed.append(e)

BUDGET = {"max": None, "used": 0}   # `learn --max-calls`: a reflection costs 1, plus 1 per lesson for its contradiction check

def reflect(text, default_project, known_projects):
    """Lessons in text. [] when there is nothing to read or MEMORY_LLM=none; ReflectorFailed when no answer came, or
    when a `learn --max-calls` budget is spent."""
    if not text.strip(): return []
    if BUDGET["max"] is not None and BUDGET["used"] >= BUDGET["max"]:
        raise ReflectorFailed(f"its --max-calls budget of {BUDGET['max']} is spent")
    out = llm(f"Known project slugs: {', '.join(sorted(known_projects | {default_project, 'all'}))}\n"
              f"Default project for this conversation: {default_project}\n\n<conversation>\n{text[-CFG['transcript_chars']:]}\n</conversation>",
              REFLECT_SYS)
    if out is None:
        if CFG["llm"] == "none": return []
        why, REFLECTOR["why"] = REFLECTOR["why"] or "the log line above says why", ""   # never report a stale reason
        raise ReflectorFailed(f"the Reflector gave no answer: {why}")
    items = parse_json(out) or []
    found = [(as_project(i.get("project") or default_project, default_project), str(i["text"])) for i in items if isinstance(i, dict) and i.get("text")]
    BUDGET["used"] += 1 + len(found)
    return found

def known_projects(c):
    return {r[0] for r in c.execute("SELECT DISTINCT project FROM lessons")}


# ---------------------------------------------------------------- contradiction check (ADD-only supersession)
CONTRA_SYS = ('Given a NEW lesson and CANDIDATE lessons from the same project, decide for each candidate: "same" (restates the new lesson), '
              '"contradicts" (cannot both be true; the new one is more recent), or "unrelated". '
              'Output ONLY JSON: {"same": ["id",...], "contradicts": ["id",...]}.')

def reconcile(c, new_id):
    r = c.execute("SELECT * FROM lessons WHERE id=?", (new_id,)).fetchone()
    cands = [x for x in search(c, r["text"], r["project"], k=6) if x["id"] != new_id]
    if not cands: return
    out = parse_json(llm(f"NEW: {r['text']}\nCANDIDATES:\n" + "\n".join(f"{x['id']}: {x['text']}" for x in cands), CONTRA_SYS, 300))
    if not isinstance(out, dict): out = {}   # an answer shaped as an array is no verdict, not a crash mid-run
    for sid in out.get("same", []):
        if any(x["id"] == sid for x in cands):  # merge: fold votes into the older, retire the new
            c.execute("UPDATE lessons SET votes=votes+?, last_seen=? WHERE id=?", (r["votes"], NOW(), sid))
            c.execute("UPDATE lessons SET state='merged', superseded_by=? WHERE id=?", (sid, new_id))
            return
    for cid in out.get("contradicts", []):
        if any(x["id"] == cid for x in cands):
            c.execute("UPDATE lessons SET state='superseded', superseded_by=? WHERE id=?", (new_id, cid))


# ---------------------------------------------------------------- adapters
def journal_write(lines, role="manual"):
    """One new file per event; never appends. lines = ['[proj] text', ...].
    Exclusive create ('x') plus a nanosecond stamp: two events in the same process, same tick, still get two files."""
    if not lines: return None
    d = JOURNAL / datetime.now().strftime("%Y-%m-%d"); d.mkdir(parents=True, exist_ok=True)
    for n in range(1000):
        p = d / f"{time.time_ns() + n}-{os.getpid()}-{role}.md"
        try:
            with open(p, "x") as f: f.write("\n".join(lines) + "\n")
            return p
        except FileExistsError: continue
    raise RuntimeError("journal_write: could not allocate a unique filename")

def ingest_journal(c):
    """Every journal/**/*.md not yet seen. Files are immutable so (path) is the cursor."""
    seen = {r[0] for r in c.execute("SELECT key FROM sources WHERE key LIKE 'journal:%'")}
    new = []
    for p in sorted(JOURNAL.glob("**/*.md")):
        key = f"journal:{p.relative_to(JOURNAL)}"
        if key in seen: continue
        for line in p.read_text(errors="ignore").splitlines():
            m = LESSON_RE.match(line.strip())
            if m: new.append(upsert(c, m.group(1), m.group(2)))
        c.execute("INSERT OR REPLACE INTO sources VALUES(?,?,?)", (key, "", NOW()))
    return new

def transcript_turns(path, start=0):
    """Claude Code or Cursor JSONL transcript → ([(turn text, byte offset just past it)], end offset). Incremental from
    a byte offset. A last line with no newline is still being written: it is left for the next read, not skipped."""
    out, pos = [], start
    with open(path, "rb") as f:
        f.seek(start)
        for raw in f:
            if not raw.endswith(b"\n"): break
            pos += len(raw)
            turn = line_turn(raw)
            if turn: out.append((turn, pos))
    return out, pos

def line_turn(raw):
    """One transcript line → "USER: text" or "ASSISTANT: text"; None for anything else. Claude Code marks a turn with
    `type`, Cursor with `role`."""
    try: j = json.loads(raw)
    except json.JSONDecodeError: return None
    kind = (j.get("type") or j.get("role")) if isinstance(j, dict) else None
    if kind not in ("user", "assistant"): return None
    msg = j.get("message")
    content = msg.get("content") if isinstance(msg, dict) else None
    if isinstance(content, list):
        content = "\n".join(b["text"] for b in content if isinstance(b, dict) and b.get("type") == "text" and isinstance(b.get("text"), str))
    elif not isinstance(content, str):
        return None     # null, missing, or a shape this version does not know: not a turn, and never an exception
    return f"{kind.upper()}: {content.strip()}" if content.strip() else None

def reflector_transcript(path):
    """A transcript the Reflector's own `claude -p` call left behind, before it passed --no-session-persistence: its
    first user turn is the Reflector's instructions. Reading one would reflect a window of another transcript again."""
    with open(path, "rb") as f:
        first = next((t for t in map(line_turn, f) if t and t.startswith("USER: ")), "")
    return first[len("USER: "):].startswith((REFLECT_SYS[:40], CONTRA_SYS[:40]))

def claude_code_turns(path, start=0):
    """Claude Code JSONL transcript → (text, end_offset). Incremental from byte offset."""
    turns, end = transcript_turns(path, start)
    return "\n\n".join(t for t, _ in turns), end

def turn_windows(turns, start, size):
    """Group (turn text, offset past it) into [(window text, offset to resume from once it is reflected)], each window
    at most `size` chars. A turn longer than a window is cut, and only its last piece moves the offset past it."""
    out, buf, done = [], "", start
    for text, end in turns:
        if buf and len(buf) + 2 + len(text) > size:
            out.append((buf, done)); buf = ""
        if len(text) > size:
            pieces = [text[i:i + size] for i in range(0, len(text), size)]
            out += [(p, done) for p in pieces[:-1]] + [(pieces[-1], end)]
        else:
            buf = f"{buf}\n\n{text}" if buf else text
        done = end
    return out + ([(buf, done)] if buf else [])

HOOK_WINDOWS = 2   # a Stop hook reflects at most this many windows, oldest first; the rest waits for the next stop

def ingest_transcript(c, path, project, backfill=False):
    """Reflect a transcript from its cursor, window by window, moving the cursor after each, so a ReflectorFailed
    part-way costs none of the windows already reflected. A backfill reads every window. A Stop hook reads at most
    HOOK_WINDOWS, oldest first: a stop follows every turn, so that is usually one call, and a session whose earlier
    stops could not get the lock is caught up by its next stops or a backfill, never skipped. A turn cut across
    windows is read to its last piece, the only one that moves the cursor past it."""
    key = f"transcript:{path}"
    start = int(cursor(c, key) or 0)
    turns, end = transcript_turns(path, start)
    windows = turn_windows(turns, start, CFG["transcript_chars"])
    n = len(windows) if backfill else HOOK_WINDOWS
    while n < len(windows) and windows[n - 1][1] == (windows[n - 2][1] if n > 1 else start):
        n += 1   # stopping inside a cut turn would never move the cursor, and would send its pieces again
    new = []
    with carrying(new):
        for text, done in windows[:n]:
            new += [upsert(c, p, t) for p, t in reflect(text, project, known_projects(c))]
            set_cursor(c, key, str(done))
    if n >= len(windows): set_cursor(c, key, str(end))
    return new

def export_msg_text(m):
    """claude.ai export messages carry `text`, or `content: [{type: text, text}]` in newer exports. A null or unknown
    shape is empty text, not an exception: one odd message must not roll back the whole export."""
    if isinstance(m.get("text"), str) and m["text"]: return m["text"]
    blocks = m.get("content") if isinstance(m.get("content"), list) else []
    return "\n".join(b["text"] for b in blocks if isinstance(b, dict) and b.get("type") == "text" and isinstance(b.get("text"), str)).strip()

def ingest_export(c, path):
    """claude.ai data export (conversations.json). Covers web, Desktop, mobile, Cowork chats."""
    convs = json.loads(Path(path).read_text())
    new = []
    with carrying(new):
        for cv in convs:
            key = f"export:{cv.get('uuid')}"; upd = cv.get("updated_at", "")
            row = c.execute("SELECT cursor FROM sources WHERE key=?", (key,)).fetchone()
            if row and row["cursor"] == upd: continue
            text = "\n\n".join(f"{m.get('sender','').upper()}: {t}" for m in cv.get("chat_messages", []) if (t := export_msg_text(m)))
            slug = re.sub(r"[^a-z0-9]+", "-", (cv.get("name") or "all").lower()).strip("-")[:40] or "all"
            got = [upsert(c, p, t) for p, t in reflect(text, slug, known_projects(c))]
            c.execute("INSERT OR REPLACE INTO sources VALUES(?,?,?)", (key, upd, NOW()))
            new += checkpoint(c, got)
    return new


# ---------------------------------------------------------------- learn (repos, notes, transcript backfill)
DOC_GLOBS = ("README*", "CLAUDE.md", "AGENTS.md", "CONTRIBUTING.md", "CHANGELOG.md", "HANDOFF.md", "docs/**/*.md", "*.md")
DOC_MAX_CHARS = 20000

TASK_ITEM = re.compile(r"[-*+]\s+\[[ xX]\]\s")   # `- [x] done` is a Markdown checklist, not a `[project]` tag

def split_tagged(text):
    """Lines of the form `[proj] fact` (optionally as a `- ` bullet) are lessons already; return them and the remaining prose.
    A Markdown task-list item (`- [x] done`, `- [ ] todo`) is prose."""
    tagged, rest = [], []
    for line in text.splitlines():
        s = line.strip()
        m = None if TASK_ITEM.match(s) else LESSON_RE.match(s.lstrip("-* ").strip())
        if m: tagged.append((m.group(1), m.group(2)))
        else: rest.append(line)
    return tagged, ("\n".join(rest).strip() if any(line.strip() for line in rest) else "")

def sha(text): return hashlib.sha1(text.encode(errors="ignore")).hexdigest()[:12]

def lesson_line(project, text):
    """A journal line for one remembered lesson, or (None, why not). The journal is read back with LESSON_RE, so a
    slug it does not match, or a lesson's second line, would be dropped in silence after the caller was told the
    lesson was saved."""
    p = as_project(project, ""); t = " ".join(str(text).split())
    if not p: return None, f"{project!r} is not a project slug: lower-case letters or digits, then . _ - as well"
    if not t: return None, "the lesson is empty"
    return f"[{p}] {t}", None

def cursor(c, key):
    r = c.execute("SELECT cursor FROM sources WHERE key=?", (key,)).fetchone()
    return r["cursor"] if r else None

def set_cursor(c, key, value):
    c.execute("INSERT OR REPLACE INTO sources VALUES(?,?,?)", (key, value, NOW()))

def reflect_batches(c, chunks, project, label, done=lambda name: None):
    """Reflect a list of (name, text) in ~30k-char windows. Returns upsert results. `done(name)` is called for each
    chunk once its window is reflected, so a caller moves that chunk's cursor and no further.
    The budget counts each `### name` header and the label, not just the text, so reflect()'s
    30k tail cut never removes the head of a window."""
    new, buf, size = [], [], 0
    budget = CFG["transcript_chars"] - len(f"[{label}]\n")
    def flush():
        nonlocal buf, size
        if buf:
            text = "\n\n".join(f"### {n}\n{t}" for n, t in buf)
            new.extend(upsert(c, p, t) for p, t in reflect(f"[{label}]\n{text}", project, known_projects(c)))
            for n, _ in buf: done(n)
            buf, size = [], 0
    with carrying(new):
        for name, whole in chunks:
            text = whole[:DOC_MAX_CHARS]; piece = len(f"### {name}\n{text}") + 2   # + the "\n\n" that joins it
            if size + piece > budget: flush()
            buf.append((name, text)); size += piece
        flush()
    return new

def git(repo, *args):
    r = subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True, check=False)
    return r.stdout if r.returncode == 0 else ""

def git_ok(repo, *args):
    """For commands whose success is silent (cat-file -e): the exit status, not stdout."""
    return subprocess.run(["git", "-C", str(repo), *args], capture_output=True, check=False).returncode == 0

def repo_slug(path):
    top = git(path, "rev-parse", "--show-toplevel").strip() or str(path)
    return Path(top).name.lower()

def take_docs(c, files, key_of, name_of):
    """Upsert each changed file's `[proj] fact` lines now; return its prose for the Reflector and a callback that marks
    a file read once its prose is reflected. Until then its cursor is "tagged:<hash>": the tagged lines are in and only
    the prose is owed, so a retry after a ReflectorFailed neither loses the prose nor counts a tagged line twice."""
    new, prose, pending = [], [], {}
    for f in files:
        text = f.read_text(errors="ignore"); key = key_of(f); h = sha(text); cur = cursor(c, key)
        if cur == h: continue
        tagged, rest = split_tagged(text)
        if cur != f"tagged:{h}": new += [upsert(c, pr, t) for pr, t in tagged]
        set_cursor(c, key, f"tagged:{h}" if rest else h)
        if rest: prose.append((name_of(f), rest)); pending[name_of(f)] = (key, h)
    return new, prose, lambda name: set_cursor(c, *pending[name])

def learn_repo(c, path, since=None):
    """Commit messages since the last seen hash, plus docs whose content hash changed. One Reflector batch per window;
    the commit cursor follows the windows, so a ReflectorFailed part-way resumes at the first commit not yet read."""
    path = Path(path).expanduser().resolve(); project = repo_slug(path); new = []
    with carrying(new):
        head = git(path, "rev-parse", "HEAD").strip()
        if head:
            key = f"repo:{path}:commits"; last = cursor(c, key)
            rng = f"{last}..HEAD" if last and git_ok(path, "cat-file", "-e", last) else "HEAD"   # a rewritten history falls back to full
            args = ["log", rng, "--no-merges", "--format=%x1e%H %ad %s%n%b", "--date=short", "--reverse"]  # \x1e opens each commit; %H never goes ambiguous
            if since and not last: args.append(f"--since={since}")
            commits = [e.strip() for e in git(path, *args).split("\x1e") if e.strip()]   # a body's blank lines stay in its commit
            if commits and head != last:   # one chunk per commit, so a long history is windowed, not truncated
                new += checkpoint(c, reflect_batches(c, [(f"commit {e.split()[0]}", e) for e in commits], project,
                                                     f"git history of {project}",
                                                     done=lambda name: set_cursor(c, key, name.split()[1])))
            set_cursor(c, key, head)
        files = []
        for g in DOC_GLOBS:   # README.md matches two globs; each file is read once
            files += [f for f in sorted(path.glob(g)) if f not in files and f.is_file() and ".git" not in f.parts and f.stat().st_size <= 2_000_000]
        got, docs, done = take_docs(c, files, lambda f: f"repo:{path}:doc:{f.relative_to(path)}", lambda f: str(f.relative_to(path)))
        new += checkpoint(c, got)
        if docs: new += checkpoint(c, reflect_batches(c, docs, project, f"documentation of {project}", done))
    return new

def learn_notes(c, folder, project=None):
    """Every .md/.txt under folder. `[proj] fact` lines are ingested directly; everything else goes to the Reflector."""
    folder = Path(folder).expanduser().resolve(); project = (project or folder.name).lower(); new = []
    with carrying(new):
        files = [f for f in sorted(list(folder.rglob("*.md")) + list(folder.rglob("*.txt"))) if f.is_file()]
        got, prose, done = take_docs(c, files, lambda f: f"notes:{f}", lambda f: str(f.relative_to(folder)))
        new += checkpoint(c, got)
        if prose: new += checkpoint(c, reflect_batches(c, prose, project, f"notes in {folder.name}", done))
    return new

def project_of(cwd):
    """Project slug for a working directory, shared by the Stop hook and the backfill: the folder name,
    lowercased. A Claude Code worktree (<repo>/.claude/worktrees/<name>) belongs to <repo>, whose
    CLAUDE.md is the one that imports compiled/projects/<slug>.md."""
    m = re.search(r"([^/]+)/\.claude/worktrees/", str(cwd))
    return (m.group(1) if m else Path(cwd).name).lower() or "all"

def line_cwd(raw):
    """The `cwd` on one transcript line; None for a line without one, or one that is not a JSON object."""
    try: return json.loads(raw).get("cwd")
    except (ValueError, AttributeError): return None

def transcript_cwd(files):
    """The first `cwd` recorded in any of these transcripts; Claude Code stamps it on every turn."""
    for f in files:
        with open(f, "rb") as fh:
            cwd = next((c for c in map(line_cwd, fh) if c), None)
        if cwd: return cwd
    return None

def claude_code_project_dirs(root=None):
    """~/.claude/projects/<encoded-cwd>/ → (project slug, [transcript paths]). The encoding turns '/' and '.' into '-',
    which cannot be undone for a hyphenated repo name, so the slug comes from the cwd recorded inside the transcripts.
    A folder without one has no turns to reflect; its last '-' segment stands in."""
    root = Path(root or Path.home() / ".claude" / "projects")
    for d in sorted(root.glob("*/")):
        found = sorted(d.glob("*.jsonl")); files = [f for f in found if not reflector_transcript(f)]
        if found and not files: continue   # a folder holding only the Reflector's own sessions
        cwd = transcript_cwd(files)
        yield (project_of(cwd) if cwd else d.name.rstrip("-").rsplit("-", 1)[-1].lower() or "all"), files

def learn_transcripts(c, root=None):
    new = []
    with carrying(new):
        for slug, files in claude_code_project_dirs(root):
            for f in files: new += checkpoint(c, ingest_transcript(c, f, slug, backfill=True))
    return new

def learn_all(c, repos_root=None, notes=None, exports=None):
    new = []
    with carrying(new):
        new += learn_transcripts(c)
        for r in sorted(Path(repos_root).expanduser().glob("*/")) if repos_root else []:
            if (r / ".git").exists(): new += learn_repo(c, r)
        if notes and Path(notes).expanduser().exists(): new += learn_notes(c, notes)
        for e in sorted(Path(exports).expanduser().glob("*.json")) if exports else []:
            new += ingest_export(c, e)
    return new


# ---------------------------------------------------------------- compile + prune
def prune(c):
    now = time.time(); archived = []
    for r in c.execute("SELECT * FROM lessons WHERE state='active'").fetchall():
        if r["harmful"] >= 2 or score(r, now) < CFG["min_score"]:
            c.execute("UPDATE lessons SET state='archived' WHERE id=?", (r["id"],)); archived.append(r)
    if archived:
        ARCHIVE.mkdir(exist_ok=True)
        with open(ARCHIVE / f"{datetime.now():%Y-%m}.md", "a") as f:
            for r in archived: f.write(f"- [{r['project']}] {r['text']}  <!-- {r['id']} votes={r['votes']} last={r['last_seen'][:10]} -->\n")
    return len(archived)

def atomic_write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp"); tmp.write_text(text); os.replace(tmp, path)

def compile_(c):
    n_pruned = prune(c)
    rows = c.execute("SELECT * FROM lessons WHERE state='active'").fetchall()
    now = time.time(); rows.sort(key=lambda r: -score(r, now))
    by = {}
    for r in rows: by.setdefault(r["project"], []).append(r)
    def fmt(r): return f"- ({r['votes']}) {r['text']}"
    atomic_write(COMPILED / "PLAYBOOK.md", "\n".join(fmt(r) for r in by.get("all", [])[:CFG["max_lines"]]) + "\n")
    for proj, rs in by.items():
        if proj == "all": continue
        if as_project(proj, "") != proj: log(f"skipping project {proj!r}: not a slug"); continue   # a store written before as_project
        atomic_write(COMPILED / "projects" / f"{proj}.md", "\n".join(fmt(r) for r in rs[:CFG["max_lines"]]) + "\n")
    for p in (COMPILED / "projects").glob("*.md"):   # remove compiled files for projects with no active lessons
        if p.stem not in by: p.unlink()
    if shutil.which("git") and (ROOT / ".git").exists():
        subprocess.run(["git", "-C", str(ROOT), "add", "-A"], capture_output=True, check=False)
        subprocess.run(["git", "-C", str(ROOT), "commit", "-qm", f"compile {NOW()}"], capture_output=True, check=False)
    return len(rows), n_pruned

def post_ingest(c, new):
    embed_missing(c)
    for i, is_new in new:
        if is_new: reconcile(c, i)

def checkpoint(c, got):
    """Reconcile and commit one source's lessons before reading the next. A `learn` used to be a single transaction,
    so a crash, a reboot or a Ctrl-C discarded every lesson and every cursor the run had earned, however many hours
    it had been working. Now an interruption costs the source in hand and nothing else. Returns `got`, to be added
    to the run's tally."""
    post_ingest(c, got); c.commit()
    return got


# ---------------------------------------------------------------- commands
def cmd_hook(a):
    if os.environ.get("MEMORY_REFLECT"): return          # we are inside our own `claude -p`; do nothing
    j = json.loads(Path(a.input).read_text()) if a.input else json.load(sys.stdin)
    msg = j.get("last_assistant_message", "") or ""
    lines = [ln.strip() for ln in msg.split("LESSONS:", 1)[1].splitlines() if LESSON_RE.match(ln.strip())] if "LESSONS:" in msg else []
    journal_write(lines, a.role)
    project = a.project or project_of(j.get("cwd") or os.getcwd())
    with Lock(), db() as c:
        new = ingest_journal(c)
        tp = j.get("transcript_path")
        if tp and Path(tp).exists() and CFG["llm"] != "none":
            try: new += ingest_transcript(c, tp, project)
            except ReflectorFailed as e: new += e.new; log(f"hook {a.role}: {e}; the rest of the transcript waits for the next stop")
        post_ingest(c, new); c.commit()
        n, p = compile_(c); c.commit()
    log(f"hook {a.role}: +{sum(1 for _,x in new if x)} new, {n} active, {p} pruned")

STOPPED = "memory: {} stopped early: {}. What was read is kept and compiled; run it again to resume."

def stop_early(cmd, why):
    """Exit 1 after a run that read something, 2 after one that read nothing at all. A scheduled job can then tell
    "I am part-way through" from "I have not worked since Friday", which no amount of re-running will fix."""
    print(STOPPED.format(cmd, why), file=sys.stderr)
    sys.exit(1 if BUDGET["used"] else 2)

def cmd_ingest(a):
    BUDGET.update(used=0)
    with Lock(a.wait), db() as c:
        new = ingest_journal(c)
        with stopping(new) as failed:
            if a.transcript: new += ingest_transcript(c, a.transcript, a.project or "all")
            if a.export: new += ingest_export(c, a.export)
        post_ingest(c, new); c.commit()
        n, p = compile_(c); c.commit()
    log(f"ingest: +{sum(1 for _,x in new if x)} new, {n} active, {p} pruned")
    if failed: stop_early("ingest", failed[0])

def cmd_learn(a):
    """Read everything once, then only what changed. Idempotent; cursors live in `sources`. At the first
    ReflectorFailed it stops, keeps and compiles what was read, and exits non-zero; the next run resumes there."""
    missing = [r for r in a.repo or [] if not Path(r).expanduser().is_dir()]
    if missing: sys.exit(f"memory: learn --repo: no such folder: {', '.join(missing)}")   # a typo must not pass for success
    BUDGET.update(max=a.max_calls, used=0)
    with Lock(), db() as c:
        new = ingest_journal(c)
        with stopping(new) as failed:
            if a.all: new += learn_all(c, a.repos or (Path.home() / "GitHub"), a.notes, a.exports or (ROOT / "exports"))
            for r in a.repo or []: new += learn_repo(c, r, a.since)
            if a.notes and not a.all: new += learn_notes(c, a.notes, a.project)
            if a.transcripts and not a.all: new += learn_transcripts(c)
            for e in a.export or []: new += ingest_export(c, e)
        post_ingest(c, new); c.commit()
        n, p = compile_(c); c.commit()
    log(f"learn: +{sum(1 for _,x in new if x)} new, {n} active, {p} pruned")
    if failed: stop_early("learn", failed[0])

def cmd_compile(a):
    with Lock(), db() as c:
        embed_missing(c); n, p = compile_(c); c.commit()
    log(f"compile: {n} active, {p} pruned")

def cmd_search(a):
    with db() as c:
        for r in search(c, a.query, a.project, a.k, a.all):
            print(f"{r['id']}  ({r['votes']}) [{r['project']}] {r['text']}")

def cmd_remember(a):
    line, why = lesson_line(a.project, a.text)
    if why: sys.exit(f"memory: nothing was saved: {why}")
    p = journal_write([line], "manual")
    with Lock(), db() as c:
        new = ingest_journal(c); post_ingest(c, new); c.commit(); compile_(c); c.commit()
    log(f"remembered → {p.name}")

def cmd_vote(a):
    col = "helpful" if a.helpful else "harmful"
    with Lock(), db() as c:
        voted = c.execute(f"UPDATE lessons SET {col}={col}+1 WHERE id=?", (a.id,)).rowcount
        c.commit(); compile_(c); c.commit()
    if not voted: sys.exit(f"memory: no lesson has id {a.id}; `memory search` prints the id beside each one")

def cmd_mcp(a):
    """MCP server. Works with mcp 1.x (FastMCP) and 2.x (MCPServer)."""
    try:
        from mcp.server.mcpserver import MCPServer as Server; v2 = True
    except ImportError:
        try:
            from mcp.server.fastmcp import FastMCP as Server; v2 = False
        except ImportError: raise SystemExit("pip install mcp") from None
    srv = Server("memory") if v2 else Server("memory", host="0.0.0.0", port=a.port)

    @srv.tool()
    def recall(query: str, project: str = "", k: int = 8) -> str:
        """Search the user's long-term memory. Returns ranked lessons with ids."""
        with db() as c:
            rs = search(c, query, project or None, k)
        return "\n".join(f"{r['id']} ({r['votes']}) [{r['project']}] {r['text']}" for r in rs) or "no matches"

    @srv.tool()
    def remember(text: str, project: str = "all") -> str:
        """Save one durable lesson. project = slug or 'all'."""
        line, why = lesson_line(project, text)
        if why: return f"not saved: {why}"
        journal_write([line], "mcp")
        try:
            with Lock(), db() as c:
                new = ingest_journal(c); post_ingest(c, new); c.commit(); compile_(c); c.commit()
        except LockBusy:                          # the journal file is written; the next compile picks it up
            return f"saved to {project}; it reaches compiled/ when the running learn ends"
        return f"saved to {project}"

    @srv.tool()
    def feedback(lesson_id: str, helpful: bool = True) -> str:
        """Mark a recalled lesson as helpful or harmful (harmful x2 archives it)."""
        col = "helpful" if helpful else "harmful"
        try:
            with Lock(), db() as c:
                voted = c.execute(f"UPDATE lessons SET {col}={col}+1 WHERE id=?", (lesson_id,)).rowcount
                c.commit(); compile_(c); c.commit()
        except LockBusy:
            return "busy: a learn run holds the store; send the feedback again when it ends"
        return "ok" if voted else f"no lesson has id {lesson_id}"

    if a.transport == "http":
        srv.run(transport="streamable-http", host="0.0.0.0", port=a.port) if v2 else srv.run(transport="streamable-http")
    else:
        srv.run(transport="stdio")


def main():
    ap = argparse.ArgumentParser(prog="memory"); sp = ap.add_subparsers(dest="cmd", required=True)
    s = sp.add_parser("hook"); s.add_argument("--role", default="main"); s.add_argument("--input"); s.add_argument("--project"); s.set_defaults(f=cmd_hook)
    s = sp.add_parser("ingest"); s.add_argument("--transcript"); s.add_argument("--project"); s.add_argument("--export")
    s.add_argument("--wait", type=float, default=LOCK_WAIT, help="seconds to wait for the lock (the SessionStart hook passes 2)")
    s.set_defaults(f=cmd_ingest)
    s = sp.add_parser("learn", help="read repos, notes, transcripts and exports; only what changed since last time")
    s.add_argument("--all", action="store_true", help="transcripts + every git repo under --repos + --notes + exports/")
    s.add_argument("--repos", help="folder of git repos for --all (default ~/GitHub)")
    s.add_argument("--repo", action="append", help="one git repo: commit messages + docs")
    s.add_argument("--since", help="first-time commit window for --repo, e.g. 2025-01-01")
    s.add_argument("--notes", help="folder of .md/.txt notes")
    s.add_argument("--project", help="project slug for --notes (default: folder name)")
    s.add_argument("--transcripts", action="store_true", help="backfill every Claude Code transcript under ~/.claude/projects")
    s.add_argument("--export", action="append", help="claude.ai conversations.json")
    s.add_argument("--exports", help="folder of exports for --all (default $MEMORY_ROOT/exports)")
    s.add_argument("--max-calls", type=int, help="stop after about N Reflector calls, contradiction checks included; the next run carries on")
    s.set_defaults(f=cmd_learn)
    s = sp.add_parser("compile"); s.set_defaults(f=cmd_compile)
    s = sp.add_parser("search"); s.add_argument("query"); s.add_argument("--project"); s.add_argument("-k", type=int, default=8)
    s.add_argument("--all", action="store_true"); s.set_defaults(f=cmd_search)
    s = sp.add_parser("remember"); s.add_argument("text"); s.add_argument("--project", default="all"); s.set_defaults(f=cmd_remember)
    s = sp.add_parser("vote"); s.add_argument("id"); g = s.add_mutually_exclusive_group(required=True)
    g.add_argument("--helpful", action="store_true"); g.add_argument("--harmful", action="store_true"); s.set_defaults(f=cmd_vote)
    s = sp.add_parser("mcp"); s.add_argument("--transport", choices=["stdio", "http"], default="stdio")
    s.add_argument("--port", type=int, default=8765); s.set_defaults(f=cmd_mcp)
    a = ap.parse_args(); a.f(a)

if __name__ == "__main__":
    main()
