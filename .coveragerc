# Coverage configuration.
#
# SCOPE. The gate is 100 per cent of lines and branches over the tool, `bin/memory`, and the two
# tools CI relies on, `tools/check_docs.py` and `tools/eval_recall.py`. Nothing is excluded: the
# network clients (the Anthropic SDK, `claude -p`, the embedding calls, the MCP transports) are
# exercised against stand-ins, and each script's `__main__` block is run with runpy. Test code,
# the fakes under `tools/e2e/` included, is not measured.
[run]
branch = True
include =
    bin/memory
    tools/check_docs.py
    tools/eval_recall.py

[report]
show_missing = True
skip_covered = False
fail_under = 100
