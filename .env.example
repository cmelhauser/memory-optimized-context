# With a real key here the hooks use the container (hooks/runner.sh). Keep this placeholder for the
# native install, which reflects through `claude -p` on your subscription.
ANTHROPIC_API_KEY=sk-ant-...
MEMORY_MODEL=claude-haiku-4-5-20251001
MEMORY_EMBED=none
# VOYAGE_API_KEY=pa-...
# The container runs as uid 10001 by default. Docker Desktop (macOS) maps what it writes to you. On Linux, name your own
# uid and gid so it can write ~/memory:
# MEMORY_UID=1000
# MEMORY_GID=1000
